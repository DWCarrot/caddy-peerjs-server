{
	debug
	admin off
    https_port 8443
	local_certs
    skip_install_trust

	servers :60943 {
		protocols h1
	}
}

localhost:8443 {
    encode gzip


    root {$CADDY_WWW_ROOT}

    reverse_proxy /pjs/* http://localhost:60943

    file_server / {
		index index.html
	}
}

# Keep WebSocket handshakes on HTTP/1.1 for coder/websocket.
http://localhost:60943 {

	route /pjs/* {
		peerjs_server {
			path /pjs/
			alive_timeout	60s
			allow_discovery
		}
	}
}